/// Permutation importance on the hold-out sample.
table 'PD Drivers'

	column Feature
		dataType: string
		summarizeBy: none
		sourceColumn: Feature

	column AUCDrop
		dataType: double
		isHidden
		formatString: 0.000
		summarizeBy: none
		sourceColumn: AUCDrop

	partition 'PD Drivers' = m
		mode: import
		source =
				let
				    Source = fnLoadCsv("pd_feature_importance.csv"),
				    Typed = Table.TransformColumnTypes(Source, {{"Feature", type text}, {"AUCDrop", type number}}, "en-US")
				in
				    Typed

	annotation PBI_ResultType = Table
