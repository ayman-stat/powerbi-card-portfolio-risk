    "objects": {
      "general": [
        {
          "properties": {
            "paragraphs": [
              {
                "textRuns": [
                  {
                    "value": "Where the money comes from",
                    "textStyle": {
                      "fontFamily": "Segoe UI Semibold",
                      "fontSize": "22px",
                      "color": "#151A23"
                    }
                  }
                ],
                "horizontalTextAlignment": "left"
              },
              {
                "textRuns": [
                  {
                    "value": " ",
                    "textStyle": {
                      "fontFamily": "Segoe UI",
                      "fontSize": "8px",
                      "color": "#151A23"
                    }
                  }
                ],
                "horizontalTextAlignment": "left"
              },
              {
                "textRuns": [
                  {
                    "value": "•  The merchant pays a service charge on each card sale.",
                    "textStyle": {
                      "fontFamily": "Segoe UI",
                      "fontSize": "16px",
                      "color": "#151A23"
                    }
                  }
                ],
                "horizontalTextAlignment": "left"
              },
              {
                "textRuns": [
                  {
                    "value": " ",
                    "textStyle": {
                      "fontFamily": "Segoe UI",
                      "fontSize": "8px",
                      "color": "#151A23"
                    }
                  }
                ],
                "horizontalTextAlignment": "left"
              },
              {
                "textRuns": [
                  {
                    "value": "•  Most of it is interchange, paid by the acquirer to the issuer.",
                    "textStyle": {
                      "fontFamily": "Segoe UI",
                      "fontSize": "16px",
                      "color": "#151A23"
                    }
                  }
                ],
                "horizontalTextAlignment": "left"
              },
              {
                "textRuns": [
                  {
                    "value": " ",
                    "textStyle": {
                      "fontFamily": "Segoe UI",
                      "fontSize": "8px",
                      "color": "#151A23"
                    }
                  }
                ],
                "horizontalTextAlignment": "left"
              },
              {
                "textRuns": [
                  {
                    "value": "•  The network charges issuers and acquirers fees on volume and per transaction, plus higher fees on cross-border payments.",
                    "textStyle": {
                      "fontFamily": "Segoe UI",
                      "fontSize": "16px",
                      "color": "#151A23"
                    }
                  }
                ],
                "horizontalTextAlignment": "left"
              },
              {
                "textRuns": [
                  {
                    "value": " ",
                    "textStyle": {
                      "fontFamily": "Segoe UI",
                      "fontSize": "8px",
                      "color": "#151A23"
                    }
                  }
                ],
                "horizontalTextAlignment": "left"
              },
              {
                "textRuns": [
                  {
                    "value": "•  The issuer also earns interest and fees from cardholders who revolve.",
                    "textStyle": {
                      "fontFamily": "Segoe UI",
                      "fontSize": "16px",
                      "color": "#151A23"
                    }
                  }
                ],
                "horizontalTextAlignment": "left"
              },
              {
                "textRuns": [
                  {
                    "value": " ",
                    "textStyle": {
                      "fontFamily": "Segoe UI",
                      "fontSize": "8px",
                      "color": "#151A23"
                    }
                  }
                ],
                "horizontalTextAlignment": "left"
              }
            ]
          }
        }
      ]
